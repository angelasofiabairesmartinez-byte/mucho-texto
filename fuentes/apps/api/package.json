{
  "name": "@muchotexto/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../../.env src/servidor.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "tipos": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../../.env dist/servidor.js",
    "db:pull": "prisma db pull && prisma generate"
  },
  "dependencies": {
    "@muchotexto/shared": "workspace:*",
    "@prisma/adapter-mssql": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.7.28",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
